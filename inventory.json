<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Digital Racer — Global Marketplace</title>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@500;700;900&family=Open+Sans:wght@400;600&display=swap" rel="stylesheet">

<style>
:root {
  --bg: #050505;
  --surface: #111111;
  --surface2: #161616;
  --border: #222222;
  --text: #ffffff;
  --muted: #888888;
  --accent: #d4af37;
}

* { box-sizing: border-box; margin: 0; padding: 0; }
body { background: var(--bg); color: var(--text); font-family: 'Open Sans', sans-serif; overflow-x: hidden; }
h1, h2, h3 { font-family: 'Montserrat', sans-serif; }

/* Navigation */
nav { display: flex; justify-content: space-between; align-items: center; padding: 18px 5vw; border-bottom: 1px solid var(--border); background: rgba(5, 5, 5, 0.95); backdrop-filter: blur(10px); position: sticky; top: 0; z-index: 100; gap: 20px; flex-wrap: wrap; }
.logo { font-size: 1.1rem; font-weight: 900; letter-spacing: 4px; text-transform: uppercase; color: var(--text); text-decoration: none; white-space: nowrap; }
.logo span { color: var(--accent); }

.nav-search { display: flex; align-items: center; background: var(--surface2); border: 1px solid var(--border); border-radius: 4px; padding: 6px 12px; width: 300px; max-width: 100%; transition: border-color 0.2s; }
.nav-search:focus-within { border-color: var(--accent); }
.nav-search input { background: transparent; border: none; outline: none; color: var(--text); font-size: 0.85rem; width: 100%; font-family: 'Open Sans', sans-serif; }
.nav-search input::placeholder { color: var(--muted); }
.nav-search button { background: transparent; border: none; color: var(--accent); cursor: pointer; font-size: 0.85rem; font-weight: 700; text-transform: uppercase; margin-left: 8px; }

.nav-links { display: flex; gap: 20px; align-items: center; }
.nav-link { color: var(--muted); text-decoration: none; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 2px; font-weight: 600; transition: color 0.2s; white-space: nowrap; }
.nav-link:hover { color: var(--accent); }

/* Compact Luxury Header */
header { padding: 50px 5vw 40px; text-align: center; background: radial-gradient(circle at center top, #141414 0%, var(--bg) 70%); border-bottom: 1px solid var(--border); }
.store-badge { display: inline-flex; align-items: center; gap: 8px; background: rgba(212, 175, 55, 0.08); border: 1px solid rgba(212, 175, 55, 0.25); padding: 6px 16px; border-radius: 20px; font-size: 0.7rem; text-transform: uppercase; letter-spacing: 3px; color: var(--accent); font-weight: 700; margin-bottom: 15px; }
.store-title { font-size: clamp(2rem, 4vw, 3.5rem); font-weight: 900; text-transform: uppercase; letter-spacing: -1px; margin-bottom: 10px; }
.store-title span { color: var(--accent); }
.store-sub { max-width: 500px; margin: 0 auto; color: var(--muted); font-size: 0.9rem; line-height: 1.6; }

/* Full-Width Grid Container */
.container { width: 100%; padding: 50px 5vw; }
section { margin-bottom: 60px; }
.section-header { display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 25px; border-bottom: 1px solid var(--border); padding-bottom: 15px; }
.section-title { font-size: 1.25rem; font-weight: 800; text-transform: uppercase; letter-spacing: 2px; }
.section-title span { color: var(--accent); }
.view-all { color: var(--muted); text-decoration: none; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 2px; font-weight: 600; transition: color 0.2s; }
.view-all:hover { color: var(--accent); }

/* Product Cards */
.grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 30px; }
.product-card { background: var(--surface); border: 1px solid var(--border); border-radius: 6px; overflow: hidden; text-decoration: none; color: var(--text); display: flex; flex-direction: column; transition: transform 0.3s ease, border-color 0.3s ease; opacity: 0; transform: translateY(20px); }
.product-card:hover { transform: translateY(-5px); border-color: var(--accent); }
.prod-img-wrap { width: 100%; aspect-ratio: 4/3; background: var(--surface2); position: relative; overflow: hidden; }
.prod-img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s ease; }
.product-card:hover .prod-img { transform: scale(1.04); }
.prod-badge { position: absolute; top: 12px; right: 12px; background: rgba(5, 5, 5, 0.85); backdrop-filter: blur(4px); border: 1px solid var(--accent); color: var(--accent); padding: 4px 10px; font-size: 0.65rem; text-transform: uppercase; font-weight: 700; letter-spacing: 1px; border-radius: 3px; }

.prod-content { padding: 22px; display: flex; flex-direction: column; flex-grow: 1; }
.prod-category { font-size: 0.7rem; text-transform: uppercase; letter-spacing: 2px; color: var(--accent); font-weight: 700; margin-bottom: 8px; }
.prod-title { font-size: 1.05rem; font-weight: 700; margin-bottom: 16px; line-height: 1.4; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.prod-footer { margin-top: auto; display: flex; justify-content: space-between; align-items: center; border-top: 1px solid var(--border); padding-top: 16px; }
.prod-price { font-size: 1.2rem; font-weight: 800; color: var(--accent); font-family: 'Montserrat', sans-serif; }
.prod-btn { background: var(--surface2); color: var(--text); padding: 8px 16px; border-radius: 4px; font-size: 0.75rem; font-weight: 700; text-transform: uppercase; border: 1px solid var(--border); transition: all 0.2s; }
.product-card:hover .prod-btn { background: var(--accent); color: #000; border-color: var(--accent); }

footer { background: var(--surface); border-top: 1px solid var(--border); padding: 40px 5vw; text-align: center; color: var(--muted); font-size: 0.85rem; letter-spacing: 1px; }

@media(max-width: 850px) {
  nav { flex-direction: column; align-items: stretch; }
  .nav-search { width: 100%; }
  .grid { grid-template-columns: repeat(2, 1fr); gap: 15px; }
  .container { padding: 30px 4vw; }
}
</style>
</head>
<body>

<nav>
  <a href="index.html" class="logo">Digital<span>.</span>Racer</a>
  
  <div class="nav-search">
    <input type="text" id="search-input" placeholder="Search accounts, skins, UC...">
    <button id="search-btn">Search</button>
  </div>

  <div class="nav-links">
    <a href="catalog.html" class="nav-link">Catalog</a>
  </div>
</nav>

<header>
  <div class="store-badge">⚡ Global Marketplace</div>
  <h1 class="store-title">PUBG Mobile <span>Store</span></h1>
  <p class="store-sub">Verified accounts, exclusive car skins, and UC top-ups with instant global delivery.</p>
</header>

<div class="container">
  
  <section>
    <div class="section-header">
      <h2 class="section-title">Verified <span>Accounts</span></h2>
      <a href="catalog.html" class="view-all">View All →</a>
    </div>
    <div class="grid" id="grid-accounts">
      <p style="color: var(--muted);">Loading accounts...</p>
    </div>
  </section>

  <section>
    <div class="section-header">
      <h2 class="section-title">Car <span>Skins</span></h2>
      <a href="catalog.html" class="view-all">View All →</a>
    </div>
    <div class="grid" id="grid-skins">
      <p style="color: var(--muted);">Loading skins...</p>
    </div>
  </section>

  <section>
    <div class="section-header">
      <h2 class="section-title">UC <span>Top-Ups</span></h2>
      <a href="catalog.html" class="view-all">View All →</a>
    </div>
    <div class="grid" id="grid-uc">
      <p style="color: var(--muted);">Loading UC packages...</p>
    </div>
  </section>

</div>

<footer>
  <p>© 2026 Digital Racer. All rights reserved.</p>
</footer>

<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js"></script>

<script>
  gsap.registerPlugin(ScrollTrigger);

  function handleSearch() {
    const query = document.getElementById('search-input').value.trim();
    if (query) {
      window.location.href = `catalog.html?search=${encodeURIComponent(query)}`;
    }
  }

  document.getElementById('search-btn').addEventListener('click', handleSearch);
  document.getElementById('search-input').addEventListener('keypress', (e) => {
    if (e.key === 'Enter') handleSearch();
  });

  function createCardHTML(product) {
    const bgImage = product.thumbnail ? product.thumbnail : '';
    const badgeHtml = product.badge ? `<div class="prod-badge">${product.badge}</div>` : '';
    
    return `
      <a href="product.html?item=${encodeURIComponent(product.title)}" class="product-card">
        <div class="prod-img-wrap">
          <img src="${bgImage}" class="prod-img" alt="${product.title}" onerror="this.style.display='none'">
          ${badgeHtml}
        </div>
        <div class="prod-content">
          <div class="prod-category">${product.category || 'Asset'}</div>
          <div class="prod-title">${product.title}</div>
          <div class="prod-footer">
            <div class="prod-price">Rs. ${product.price}</div>
            <div class="prod-btn">View</div>
          </div>
        </div>
      </a>
    `;
  }

  fetch('/inventory.json')
    .then(response => response.json())
    .then(data => {
      // Robust handler: supports raw arrays AND wrapper objects
      const products = Array.isArray(data) ? data : (data.items || data.products || []);

      // Flexible category matching (case-insensitive)
      const accProducts = products.filter(p => (p.category || '').toLowerCase().includes('account')).slice(0, 4);
      const carProducts = products.filter(p => {
        const cat = (p.category || '').toLowerCase();
        return cat.includes('car') || cat.includes('skin') || cat.includes('card');
      }).slice(0, 4);
      const ucProducts = products.filter(p => (p.category || '').toLowerCase().includes('uc')).slice(0, 4);

      function renderGrid(items, containerId, label) {
        const container = document.getElementById(containerId);
        if (items.length === 0) {
          container.innerHTML = `<p style="color: var(--muted);">No ${label}s available right now.</p>`;
        } else {
          container.innerHTML = items.map(p => createCardHTML(p)).join('');
          
          gsap.to(container.querySelectorAll('.product-card'), {
            scrollTrigger: {
              trigger: container,
              start: "top 90%",
            },
            opacity: 1,
            y: 0,
            duration: 0.6,
            stagger: 0.08,
            ease: "power3.out"
          });
        }
      }

      renderGrid(accProducts, 'grid-accounts', 'Account');
      renderGrid(carProducts, 'grid-skins', 'Skin');
      renderGrid(ucProducts, 'grid-uc', 'UC Pack');
    })
    .catch(error => {
      console.error("Error loading inventory:", error);
      document.getElementById('grid-accounts').innerHTML = `<p style="color: var(--muted);">Error loading inventory.</p>`;
      document.getElementById('grid-skins').innerHTML = `<p style="color: var(--muted);">Error loading inventory.</p>`;
      document.getElementById('grid-uc').innerHTML = `<p style="color: var(--muted);">Error loading inventory.</p>`;
    });
</script>

</body>
</html>
